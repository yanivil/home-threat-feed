<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Runs news_check.sh every morning at 06:30 local time: asks Claude for the indicators the
         week's public security reporting names, looks the home-relevant ones up on VirusTotal,
         commits and pushes spark-ioc-feed.csv when rows were added (design D7). Both keys must be
         in the login Keychain first, ANTHROPIC_API_KEY and VT_API_KEY (README, "News agent"), and
         the first run should be a dry one by hand: DRY_RUN=1 bash news_check.sh.
         Forty lookups end by about 06:50; the 07:30 daily check waits for the feed lock if not.
         A run missed while the Mac slept happens on wake; one missed while it was off is skipped.
         The script is started through the Python.app binary rather than /bin/bash directly: with
         the repository on an external disk, macOS judges every file access of a launchd job by
         the job's top process, and Python.app is the one program that can hold Full Disk Access
         (see the syslog plist). bash, git and python3 run under it and need no grant of their own.
         Install: edit the two paths below if the repository lives elsewhere, then
           cp launchd/com.spark-ioc-feed.news.plist ~/Library/LaunchAgents/
           launchctl load ~/Library/LaunchAgents/com.spark-ioc-feed.news.plist
         Run now: launchctl start com.spark-ioc-feed.news
         Log:     /Users/home-server/Library/Logs/spark-ioc-feed/news-check.log
         Stop:    launchctl unload ~/Library/LaunchAgents/com.spark-ioc-feed.news.plist -->
    <key>Label</key>
    <string>com.spark-ioc-feed.news</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/Current/Resources/Python.app/Contents/MacOS/Python</string>
        <string>-c</string>
        <string>import subprocess, sys; sys.exit(subprocess.call(['/bin/bash', '/Volumes/eDisk_2TB/Projects/Personal Security Agent/spark-ioc-feed/news_check.sh']))</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Volumes/eDisk_2TB/Projects/Personal Security Agent/spark-ioc-feed</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/home-server/Library/Logs/spark-ioc-feed/news-check.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/home-server/Library/Logs/spark-ioc-feed/news-check.log</string>
</dict>
</plist>
